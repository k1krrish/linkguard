# All variables are optional. Defaults are safe for normal use.

# Max upload size for PCAP/PCAPNG files, in MB (default 10)
LINKGUARD_MAX_UPLOAD_MB=10

# Max packets analyzed per capture (default 20000)
LINKGUARD_MAX_PACKETS=20000

# Comma-separated browser origins allowed by CORS (default: Vite dev server)
LINKGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DEVELOPMENT / TESTING ONLY. When 1, live checks may target loopback/private
# addresses and any port (used to test against a local server you control).
# Never enable this on a shared or internet-facing host: it disables the SSRF guard.
LINKGUARD_ALLOW_PRIVATE_TARGETS=0

# Frontend (optional): backend URL the Vite dev/preview proxy forwards /api to
# LINKGUARD_API=http://127.0.0.1:8000
