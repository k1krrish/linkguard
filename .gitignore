# ==============================================================================
# LinkGuard 2.0 - Git Ignore Configuration
# ==============================================================================

# Python Virtual Environments & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend/dist/
frontend/dist-ssr/
dist/
*.tsbuildinfo

# Environment & Secrets (Never commit .env files)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Editors & Operating System
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# Temporary / Local PCAP Captures (app parses in memory, but prevent accidental commits)
*.local.pcap
*.local.pcapng
*.tmp
*.log
logs/
